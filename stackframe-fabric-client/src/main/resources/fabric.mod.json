{
    "schemaVersion": 1,
    "id": "stackframe_client",
    "version": "${version}",
    "name": "Stackframe Fabric Client",
    "description": "Client-side Stackframe bootstrap for Minecraft Java Edition.",
    "authors": [
        "MinecraftProt contributors"
    ],
    "contact": {
        "issues": "https://github.com/MinecraftProt/Stackframe/issues",
        "sources": "https://github.com/MinecraftProt/Stackframe"
    },
    "license": "Apache-2.0",
    "environment": "client",
    "entrypoints": {
        "preLaunch": [
            "org.minecraftprot.stackframe.fabric.client.StackframeClientPreLaunch"
        ],
        "client": [
            "org.minecraftprot.stackframe.fabric.client.StackframeClient"
        ]
    },
    "mixins": [
        "stackframe-client.mixins.json"
    ],
    "depends": {
        "fabricloader": "0.19.3",
        "minecraft": "26.2",
        "java": ">=25"
    }
}
